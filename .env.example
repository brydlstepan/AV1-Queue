# AV1 Queue launcher settings. Copy this file to .env (gitignored) and
# uncomment what you need. Read by runGUI.bat and scripts\start_queue.ps1 at
# launch; restart the server after editing. Variables already set in the real
# environment take precedence over this file.

# Port for the studio (default 8765).
# AV1QUEUE_PORT=8765

# Extra bind addresses beyond loopback, comma-separated — e.g. your Tailscale
# IP (tailscale ip -4), or 0.0.0.0 for every interface including the LAN.
# Without a login below, anything that can reach it gets full control.
# AV1QUEUE_HOST=100.x.y.z

# HTTP Basic Auth for non-loopback requests (both must be set).
# AV1QUEUE_USERNAME=
# AV1QUEUE_PASSWORD=
